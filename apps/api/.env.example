# Optional. The Express API defaults to port 4000 when this is unset.
PORT=4000

# Optional for public repositories, but recommended because authenticated GitHub API limits are higher.
GITHUB_TOKEN=

# Required only when the internal Claude repository-understanding service runs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Required only when the internal Gemini repository-understanding service runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
